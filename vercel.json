{
  "rewrites": [
    {
      "source": "/delete-account",
      "destination": "/delete-account.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/play",
      "destination": "/play/index.html"
    },
    {
      "source": "/play/:code",
      "destination": "/api/play?code=:code"
    }
  ],
  "functions": {
    "api/play.js": {
      "includeFiles": "play/index.html",
      "maxDuration": 5
    }
  }
}
