{
  "rewrites": [
    {
      "source": "/delete-account",
      "destination": "/delete-account.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/play",
      "destination": "/play/index.html"
    },
    {
      "source": "/drawing",
      "destination": "/drawing/index.html"
    },
    {
      "source": "/drawing/live",
      "destination": "/drawing/live.html"
    },
    {
      "source": "/draw",
      "destination": "/drawing/index.html"
    },
    {
      "source": "/draw/",
      "destination": "/drawing/index.html"
    },
    {
      "source": "/play/:code",
      "destination": "/api/play?code=:code"
    }
  ],
  "functions": {
    "api/play.js": {
      "includeFiles": "play/index.html",
      "maxDuration": 5
    }
  },
  "redirects": [
    {
      "source": "/privacy-policy",
      "has": [
        {
          "type": "host",
          "value": "hiipointegames.com"
        }
      ],
      "destination": "https://www.37themathpuzzle.com/privacy",
      "permanent": false
    },
    {
      "source": "/terms-and-conditions",
      "has": [
        {
          "type": "host",
          "value": "hiipointegames.com"
        }
      ],
      "destination": "https://www.37themathpuzzle.com/terms",
      "permanent": false
    },
    {
      "source": "/delete-account",
      "has": [
        {
          "type": "host",
          "value": "hiipointegames.com"
        }
      ],
      "destination": "https://www.37themathpuzzle.com/delete-account",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "hiipointegames.com"
        }
      ],
      "destination": "https://www.37themathpuzzle.com/",
      "permanent": false
    },
    {
      "source": "/privacy-policy",
      "has": [
        {
          "type": "host",
          "value": "www.hiipointegames.com"
        }
      ],
      "destination": "https://www.37themathpuzzle.com/privacy",
      "permanent": false
    },
    {
      "source": "/terms-and-conditions",
      "has": [
        {
          "type": "host",
          "value": "www.hiipointegames.com"
        }
      ],
      "destination": "https://www.37themathpuzzle.com/terms",
      "permanent": false
    },
    {
      "source": "/delete-account",
      "has": [
        {
          "type": "host",
          "value": "www.hiipointegames.com"
        }
      ],
      "destination": "https://www.37themathpuzzle.com/delete-account",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.hiipointegames.com"
        }
      ],
      "destination": "https://www.37themathpuzzle.com/",
      "permanent": false
    },
    {
      "source": "/draw",
      "destination": "/drawing",
      "permanent": true
    },
    {
      "source": "/draw/",
      "destination": "/drawing",
      "permanent": true
    }
  ]
}
